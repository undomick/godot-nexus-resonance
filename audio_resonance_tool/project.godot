[internationalization]

locale/translations=PackedStringArray("res://addons/nexus_resonance/translations/nexus_resonance.en.translation", "res://addons/nexus_resonance/translations/nexus_resonance.es.translation")

[nexus]

import/scene_style="inherited"
import/auto_assign_post_processor=true
nexus_resonance/logger/categories_enabled={
"bake": true,
"init": true,
"occlusion": true,
"pathing": true,
"realtime_rays": true,
"reflections": true,
"source_volume": true,
"validation": true
}
nexus_resonance/logger/output_to_debug=true
nexus_resonance/logger/output_to_file=false
nexus_resonance/logger/file_path="user://nexus_resonance_log.ndjson"
nexus_resonance/logger/steam_audio_verbose=false
nexus_resonance/editor/auto_convert_animation_audio_on_save=false
nexus_resonance/bake/default_output_directory="res://audio_data/"
nexus_resonance/accessibility/editor_tts=false
nexus_resonance/accessibility/runtime_debug_tts=false
nexus_resonance/accessibility/tts_voice=0
nexus_resonance/accessibility/tts_volume=50
nexus_resonance/accessibility/tts_speed=1.0

[physics]

3d/run_on_separate_thread=true
3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
